{
  "info": {
    "_postman_id": "c80ceff6-b42c-46f1-a17f-cb83583f6529",
    "name": "ParkFlow SPMS - Full Collection (via API Gateway)",
    "description": "All 4 microservices (Parking, User, Vehicle, Payment) tested end-to-end through the API Gateway on port 8080. Requests are chained: create a Parking spot -> create a User -> register that User's Vehicle -> pay for the Vehicle's Parking session.",
